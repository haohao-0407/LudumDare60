      Title: "\u4FE1\u53F7\u5206\u6790"
      Lines:
      - Speaker: 2
        Text: 'scan nearby

          Scan complete: derelict transport identified.'
        WaitForContinue: 0
        DelayAfter: 0.5
      - Speaker: 0
        Text: I have marked its position.
        WaitForContinue: 1
        DelayAfter: 0.5
      Choices:
      - Id: mark
        Label: SAVE COORDINATES
        PlayerText: Save the coordinates and return to the comms menu.
