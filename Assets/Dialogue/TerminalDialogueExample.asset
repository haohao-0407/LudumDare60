    - Id: signal
      Title: "\u53D1\u73B0\u4FE1\u53F7"
      Lines:
      - Speaker: 0
        Text: Captain, an unusual signal has been detected ahead.
        WaitForContinue: 0
        DelayAfter: 0.5
      - Speaker: 0
        Text: Its source is approximately three kilometers away.
        WaitForContinue: 0
        DelayAfter: 0.5
      Choices:
      - Id: analyze
        Label: ANALYZE SIGNAL
        PlayerText: Analyze the signal for me.
        NextNodeId: analysis
        Conditions: []
        SetFlags: []
        Events: []
      - Id: risk
        Label: ASSESS RISK
        PlayerText: What are the risks of approaching it?
        NextNodeId: risk
        Conditions: []
        SetFlags: []
        Events: []
      - Id: coordinates
        Label: SHOW COORDINATES
        PlayerText: Display the target coordinates.
        NextNodeId: coordinates
        Conditions:
        - Key: has_coordinates
          Value: 1
        SetFlags: []
        Events: []
      - Id: leave
        Label: END TRANSMISSION
        PlayerText: Keep monitoring. End transmission.
        NextNodeId: end
        Conditions: []
        SetFlags: []
        Events: []
      NextNodeId: 
