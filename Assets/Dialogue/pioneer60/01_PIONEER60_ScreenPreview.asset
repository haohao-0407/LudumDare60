    - Id: dialogue_31_ready
      Title: Ready / wait for Launch
      Lines:
      - Speaker: 2
        DisplayName: 
        Text: 'Destination: Earth

          Ready to launch.'
        UseCustomColor: 0
        CustomColor:
          R: 0.65
          G: 1
          B: 0.76
          A: 1
        WaitForContinue: 1
        DelayAfter: 0.5
      - Speaker: 0
        DisplayName: 
        Text: The ship is fully repaired. You can now return home. I won't miss you. Goodbye.
        UseCustomColor: 0
        CustomColor:
          R: 0.65
          G: 1
          B: 0.76
          A: 1
        WaitForContinue: 0
        DelayAfter: 0.5
