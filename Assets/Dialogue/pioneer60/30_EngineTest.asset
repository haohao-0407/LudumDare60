          G: 1
          B: 0.76
          A: 1
        WaitForContinue: 1
        DelayAfter: 0.5
      - Speaker: 0
        DisplayName: 
        Text: That was only a test. We have not launched. The deadline on the calendar still applies.
        UseCustomColor: 0
