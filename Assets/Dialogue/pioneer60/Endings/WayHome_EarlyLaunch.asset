    EntryNodeId: the_way_home
    InitialFlags: []
    Nodes:
    - Id: the_way_home
      Title: WayHome_EarlyLaunch
      Lines:
      - Speaker: 2
        DisplayName: 
        Text: 'DEPARTURE AUTHORIZATION ACCEPTED.

          RETURN PLAN LOCKED.

          MISSION COUNTDOWN STOPPED.'
        UseCustomColor: 0
        CustomColor:
          R: 0.65
          G: 1
          B: 0.76
          A: 1
        WaitForContinue: 1
        DelayAfter: 0.5
      - Speaker: 2
        DisplayName: NARRATION
        Text: The ship lifts away from the surface. The colony and its broken transmissions slowly fall behind you.
        UseCustomColor: 0
        CustomColor:
          R: 0.65
          G: 1
          B: 0.76
          A: 1
        WaitForContinue: 1
        DelayAfter: 0.5
      - Speaker: 2
        DisplayName: NARRATION
        Text: You reach the waiting orbit. When the planned return window arrives, the Earth-return burn begins.
        UseCustomColor: 0
        CustomColor:
          R: 0.65
          G: 1
          B: 0.76
          A: 1
        WaitForContinue: 1
        DelayAfter: 0.5
      - Speaker: 2
        DisplayName: NARRATION
        Text: Earth is still far away. You do not know what you will find when you get there.
        UseCustomColor: 0
        CustomColor:
          R: 0.65
          G: 1
          B: 0.76
          A: 1
        WaitForContinue: 1
        DelayAfter: 0.5
      - Speaker: 2
        DisplayName: NARRATION
        Text: But you are finally on your way home.
        UseCustomColor: 0
        CustomColor:
          R: 0.65
          G: 1
          B: 0.76
          A: 1
        WaitForContinue: 1
        DelayAfter: 0.5
